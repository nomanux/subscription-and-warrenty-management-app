# Firebase web config — copy this file to ".env" and fill in your real values.
# Find these in Firebase Console → Project settings → General → "Your apps" → Web app → SDK setup and configuration.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Cloudinary — for receipt image/PDF uploads.
# cloud name: Cloudinary Dashboard (top-left, "Product Environment Credentials").
# upload preset: Settings → Upload → Upload presets → create an UNSIGNED preset.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
